{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Excel Unprotector",
  "version": "0.1.0",
  "identifier": "app.cliff.excel-unprotector",
  "build": {
    "beforeDevCommand": "pnpm --dir ../excel-unprotector-nextjs dev --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node ../excel-unprotector-nextjs/scripts/export-desktop.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Excel Unprotector",
        "width": 960,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Cliff Huang",
    "copyright": "Copyright © 2026 Cliff Huang",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "category": "Utility",
    "shortDescription": "本地离线移除 Excel .xlsx 工作表保护",
    "longDescription": "Excel Unprotector 在本地离线移除 .xlsx 文件的工作表保护，不上传文件、不依赖网络。仅支持 .xlsx，不处理工作簿结构保护与图表工作表。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
